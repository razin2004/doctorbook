# PrimeCare Clinic Environment Configuration Template (.env.example)

# Flask Application & Cryptographic Secrets
FLASK_SECRET_KEY=
OTP_HASH_SECRET=
FLASK_ENV=development
RENDER=

# Database Connection (Default: local SQLite database for development)
DATABASE_URL=sqlite:///instance/primecare.db

# PostgreSQL Local Test Database URL (Mandatory for local PostgreSQL integration tests)
# Must target local instance on port 5433: postgresql://<user>:<password>@127.0.0.1:5433/primecare_test
POSTGRES_TEST_URL=postgresql://<user>:<password>@127.0.0.1:5433/primecare_test

# Admin Authentication
ADMIN_EMAIL=admin@example.com
USE_EMAIL_OTP=true

# Email Notification Services (Brevo / SMTP)
MAIL_SENDER_EMAIL=
BREVO_API_KEY=
SMTP_APP_PASSWORD=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / External APIs (Website AI: Gemini)
GOOGLE_API_KEY=

# Groq WhatsApp AI (Phase 3B)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Kapso WhatsApp Business API (Phase 2C Setup)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_BASE_URL=https://api.kapso.ai
KAPSO_API_VERSION=v24.0
KAPSO_WEBHOOK_SECRET=
KAPSO_WEBHOOK_VERIFY_TOKEN=
KAPSO_OUTBOUND_ENABLED=false
